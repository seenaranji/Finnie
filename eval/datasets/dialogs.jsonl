{"id": "d01", "note": "spec example: concept, then a ticker, then 'it'", "turns": [{"say": "What's an ETF?", "routes": ["finance_qa"]}, {"say": "How is VOO doing today?", "routes": ["market"]}, {"say": "And how much is it up this year?", "routes": ["market"], "must_contain": ["voo"]}]}
{"id": "d02", "note": "switch company, then compare both", "turns": [{"say": "How is Apple doing?", "routes": ["market"]}, {"say": "What about Microsoft?", "routes": ["market"], "must_contain": ["microsoft"]}, {"say": "Which one is more volatile?", "routes": ["market"], "must_contain": ["apple", "microsoft"]}]}
{"id": "d03", "note": "goal slot filling across replies that are meaningless alone", "turns": [{"say": "I want to save $50,000 in 5 years", "routes": ["goal"]}, {"say": "I have $2,000 saved", "routes": ["goal"], "must_contain": ["50,000"]}, {"say": "medium risk", "routes": ["goal"]}]}
{"id": "d04", "note": "account concept, then 'it'", "turns": [{"say": "What's a Roth IRA?", "routes": ["finance_qa", "tax"]}, {"say": "How much can I contribute to it this year?", "routes": ["tax"], "must_contain": ["roth"]}]}
{"id": "d05", "note": "concept, then 'they'", "turns": [{"say": "Tell me about bonds", "routes": ["finance_qa"]}, {"say": "How are they taxed?", "routes": ["tax", "finance_qa"], "must_contain": ["bond"]}]}
{"id": "d06", "note": "news, then 'and X?'", "turns": [{"say": "What's the latest news on Tesla?", "routes": ["news"]}, {"say": "And Apple?", "routes": ["news"], "must_contain": ["apple", "news"]}]}
{"id": "d07", "note": "no antecedent first, then the user supplies it", "turns": [{"say": "How is it doing?", "routes": ["clarify"]}, {"say": "I mean VOO", "routes": ["market"], "must_contain": ["voo"]}]}
{"id": "d08", "note": "topic switch: the old topic must NOT leak into the new question", "turns": [{"say": "What is inflation?", "routes": ["finance_qa"]}, {"say": "How is Apple doing?", "routes": ["market"], "must_not_contain": ["inflation"]}]}
{"id": "d09", "note": "portfolio follow-up", "portfolio_csv": "ticker,shares,avg_cost\nVTI,10,200\nBND,20,70", "turns": [{"say": "Analyze my portfolio", "routes": ["portfolio"]}, {"say": "Is it diversified?", "routes": ["portfolio"], "must_contain": ["portfolio"]}]}
{"id": "d10", "note": "small talk in the middle, then a follow-up", "turns": [{"say": "What's NVDA's price?", "routes": ["market"]}, {"say": "Thanks!", "routes": ["clarify", "finance_qa"]}, {"say": "And Tesla's?", "routes": ["market"], "must_contain": ["tesla", "price"]}]}
