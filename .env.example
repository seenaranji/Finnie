# Copy this file to .env and fill in real values. .env is git-ignored.
OPENAI_API_KEY=
# Needed from Step 12 (market data fallback). Leave empty until then.
ALPHA_VANTAGE_API_KEY=
# Needed for LangSmith evaluation (Step 8). Get one at smith.langchain.com > Settings > API Keys.
LANGSMITH_API_KEY=
# Step 23b: PostgreSQL (docker compose). DATABASE_URL must use the same user, password, port and database.
POSTGRES_USER=finnie
POSTGRES_PASSWORD=
POSTGRES_DB=finnie
POSTGRES_PORT=5433
DATABASE_URL=postgresql://finnie:<password>@127.0.0.1:5433/finnie
